# real implementation (Point is one packed 4-byte slot)
EqualPt                                      # real implementation (Point is one packed 4-byte slot)

# no component aliases exist: a component is its own target
ResolveComponentAlias                        # no component aliases exist: a component is its own target

# our GWorld pixels are never purgeable: lock always succeeds, unlock has nothing to do
LockPixels                                   # our GWorld pixels are never purgeable: lock always succeeds, unlock has nothing to do
UnlockPixels                                 # our GWorld pixels are never purgeable: lock always succeeds, unlock has nothing to do

# compositing windows need no update bracketing or grow box; debug/idle hooks do nothing
BeginUpdate                                  # compositing windows need no update bracketing or grow box; debug/idle hooks do nothing
DrawGrowIcon                                 # compositing windows need no update bracketing or grow box; debug/idle hooks do nothing
DumpControlHierarchy                         # compositing windows need no update bracketing or grow box; debug/idle hooks do nothing
EndUpdate                                    # compositing windows need no update bracketing or grow box; debug/idle hooks do nothing
IdleControls                                 # compositing windows need no update bracketing or grow box; debug/idle hooks do nothing
TEIdle                                       # compositing windows need no update bracketing or grow box; debug/idle hooks do nothing

# dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
DisposeCTable                                # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
DisposeThemeDrawingState                     # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
KillPicture                                  # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
LDispose                                     # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
ReleaseQDContextForCollapsedWindowDockTile   # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
TEDispose                                    # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)
TXNDeleteObject                              # dispose-only: at worst a leak, never wrong output (the creator is real or itself a loud stub)

# no TXNObject can ever exist (HITextViewGetTXNObject is the loud gap): nothing to clear/show
TXNClear                                     # no TXNObject can ever exist (HITextViewGetTXNObject is the loud gap): nothing to clear/show
TXNShowSelection                             # no TXNObject can ever exist (HITextViewGetTXNObject is the loud gap): nothing to clear/show

# OS X's application heap is unbounded: the largest round-trippable classic Size is the answer
MaxBlock                                     # OS X's application heap is unbounded: the largest round-trippable classic Size is the answer

# an Intel process has no PowerPC fragment to connect to: cfragNoLibraryErr/NoSymbolErr is the Intel answer
GetSharedLibrary                             # an Intel process has no PowerPC fragment to connect to: cfragNoLibraryErr/NoSymbolErr is the Intel answer
FindSymbol                                   # an Intel process has no PowerPC fragment to connect to: cfragNoLibraryErr/NoSymbolErr is the Intel answer

# AVPlayer prerolls on its own: noErr is what QuickTime reported for a ready movie
PrerollMovie                                 # AVPlayer prerolls on its own: noErr is what QuickTime reported for a ready movie
