# coverage-audit.ok — shims whose constant answer IS the correct modern semantic.
# Listed here (exported symbol # reason) they stay quiet: no GAP_STUB, no audit row.
# Every other constant-return shim carries GAP_STUB(args) and reports its first hit.

# std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIcEC1Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIcED1Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIwEC1Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIwED1Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIcEC2Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIcED2Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIwEC2ERKS_                              # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIwEC2Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSaIwED2Ev                                 # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSt9exceptionD1Ev                          # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSt9exceptionD2Ev                          # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free
_ZNSt6localeD1Ev                             # std::allocator / std::exception / std::locale ctor/dtor: no state to build or free

# C-locale numpunct answers (the classic default)
np_decimal_point                             # C-locale numpunct answers (the classic default)
np_nop                                       # C-locale numpunct answers (the classic default)
np_thousands_sep                             # C-locale numpunct answers (the classic default)

# the native unwinder finds FDEs itself; keymgr registration is obsolete
__keymgr_dwarf2_register_sections            # the native unwinder finds FDEs itself; keymgr registration is obsolete

# custom allocator hook: OpenSSL keeps the system allocator, which frees its own blocks

