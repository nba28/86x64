#!/usr/bin/env python3
"""m64 — unified driver for the 86x64 i386→x86_64 translator.

A single front-end over the translation pipeline. The low-level Mach-O surgery
still lives in the C++ `macho-tool` engine and the per-binary `86x64.sh` /
`translate-bundle` scripts; m64 ties them together with auto-discovery and
sensible defaults so whole apps can be translated, shimmed, signed, and run
with one command each.

Common flows:
    m64 translate iWeb.app            # translate every i386 binary, then shim+sign
    m64 translate iWeb.app/Contents/MacOS/iWeb   # just one binary, in place
    m64 retranslate iPhoto.app        # re-run after a translator fix
    m64 build abiconv && m64 resync iPhoto.app   # rebuild libabiconv, push to a bundle
    m64 run iPhoto.app --exc          # launch under lldb, trap ObjC exceptions
    m64 macho print iWeb.dylib        # passthrough to the low-level engine

Run `m64 <command> -h` for per-command help.
"""
import argparse
import concurrent.futures
import hashlib
import os
import plistlib
import shutil
import struct
import subprocess
import sys
from pathlib import Path

# ---- locations -------------------------------------------------------------
SCRIPT_DIR = Path(__file__).resolve().parent          # src/86x64
PROJ_ROOT  = SCRIPT_DIR.parent.parent                 # repo root


def _resolve_build_root():
    """Pick the build tree, and be LOUD when the choice is ambiguous.

    The tools are resolved relative to THIS SCRIPT, not the cwd. That is the
    right default, but it has a sharp edge: `/usr/local/bin/m64` is a symlink
    into the MAIN checkout, so a bare `m64` run from inside a git worktree
    silently uses the MAIN build. `m64 resync` then reports a cheerful
    "N copies synced" while overwriting a worktree's freshly-built libabiconv
    with master's — the agent is now testing master and does not know it.
    That has cost this project two whole investigations (a Halo "auto-dismiss"
    that was only ever stale code, and a Civ libabiconv measurement).

    So: honour an explicit M64_BUILD override, and otherwise keep the
    script-relative default but WARN when the cwd sits in a different checkout
    that has a build of its own. Warn rather than auto-switch, because silently
    changing which compiler output gets deployed is the same class of surprise
    in the other direction.
    """
    env = os.environ.get("M64_BUILD")
    if env:
        return Path(env).expanduser().resolve(), None

    default = PROJ_ROOT / "build"
    try:
        cwd_root = Path(subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True).stdout.strip()).resolve()
    except Exception:
        return default, None

    if cwd_root != PROJ_ROOT and (cwd_root / "build" / "src" / "abiconv" / "libabiconv.dylib").exists():
        return default, cwd_root / "build"
    return default, None


BUILD, _OTHER_BUILD = _resolve_build_root()
MACHO_TOOL = BUILD / "src" / "macho-tool" / "macho-tool"
LIBABICONV = BUILD / "src" / "abiconv" / "libabiconv.dylib"


def warn_if_build_ambiguous():
    """Call from any command that DEPLOYS or CONSUMES build output."""
    if _OTHER_BUILD is None:
        return
    warn(f"using build {BUILD}")
    warn(f"but the cwd is inside another checkout that has its own build: {_OTHER_BUILD}")
    warn("if you meant that one, re-run with "
         f"M64_BUILD={_OTHER_BUILD} ... (or invoke that checkout's own src/86x64/m64)")

TRANSLATE_BUNDLE = SCRIPT_DIR / "translate-bundle"
PIPELINE_SH      = SCRIPT_DIR / "86x64.sh"
RPATH_SWEEP      = SCRIPT_DIR / "_rpath_sweep.py"
VENDOR_DEPS      = SCRIPT_DIR / "_vendor_deps.py"
SHIMGEN          = SCRIPT_DIR / "shimgen.py"
FIX_SIGNING      = SCRIPT_DIR / "_fix_bundle_signing.py"
DEPLOY_SH        = SCRIPT_DIR / "_deploy_app.sh"
LLDB_EXC         = SCRIPT_DIR / "_lldb_exc_trace.py"
BACKUP_BASE      = Path.home() / ".86x64-backups"

BUNDLE_SUFFIXES = (".app", ".framework", ".bundle", ".plugin", ".kext")
# Our own runtime support libraries that get co-located in bundles — never
# themselves translation targets (libabiconv's install-name even self-matches
# the "links our runtime" probe).
OUR_RUNTIME_LIBS = {"libabiconv.dylib", "libinterpose.dylib"}


# ---- small utilities -------------------------------------------------------
class Die(Exception):
    pass


def info(msg):  print(f"\033[1;36m==>\033[0m {msg}")
def good(msg):  print(f"\033[1;32m  ok\033[0m {msg}")
def warn(msg):  print(f"\033[1;33m  !!\033[0m {msg}", file=sys.stderr)


def run(cmd, *, dry=False, check=True, env=None, cwd=None, quiet=False):
    """Run a command (list of str/Path). Returns the CompletedProcess."""
    cmd = [str(c) for c in cmd]
    if dry:
        print("  dry-run:", " ".join(cmd))
        return None
    if not quiet:
        print("  $", " ".join(cmd))
    return subprocess.run(cmd, check=check, env=env, cwd=cwd)


def macho_magic(path):
    """Return True if `path` starts with a Mach-O (thin or fat) magic number."""
    try:
        with open(path, "rb") as f:
            head = f.read(4)
    except OSError:
        return False
    if len(head) < 4:
        return False
    val = struct.unpack(">I", head)[0]
    # feedface/feedfacf (thin be/le either order), cafebabe/bebafeca (fat)
    return val in (0xFEEDFACE, 0xFEEDFACF, 0xCEFAEDFE, 0xCFFAEDFE,
                   0xCAFEBABE, 0xBEBAFECA)


def archs_of(path):
    """List of architectures in a Mach-O via `lipo -archs`, [] on failure."""
    try:
        out = subprocess.run(["lipo", "-archs", str(path)],
                             capture_output=True, text=True)
        if out.returncode == 0:
            return out.stdout.split()
        # Current lipo rejects a fat file carrying a PPC slice under -archs
        # ("not a mach-o"), but -info still lists it: "... are: ppc i386".
        out = subprocess.run(["lipo", "-info", str(path)],
                             capture_output=True, text=True)
        if out.returncode == 0 and ":" in out.stdout:
            return out.stdout.rsplit(":", 1)[1].split()
    except OSError:
        pass
    return []


def require(*paths):
    for p in paths:
        if not Path(p).exists():
            raise Die(f"required artifact missing: {p}\n"
                      f"    (try `m64 build` first)")


def find_bundle(path):
    """Walk up from `path` to the outermost enclosing bundle dir, or None."""
    path = Path(path).resolve()
    outer = None
    for p in [path, *path.parents]:
        if p.suffix in BUNDLE_SUFFIXES:
            outer = p
    return outer


def backup_root(bundle):
    # Must match translate-bundle's `echo "$path" | shasum -a 256 | cut -c1-16`,
    # which hashes the path WITH echo's trailing newline.
    path = str(Path(bundle).resolve())
    h = hashlib.sha256((path + "\n").encode()).hexdigest()[:16]
    return BACKUP_BASE / h


def bundle_executable(app):
    """The main exec relpath (Contents/MacOS/<CFBundleExecutable>) or None."""
    plist = Path(app) / "Contents" / "Info.plist"
    if not plist.exists():
        return None
    try:
        with open(plist, "rb") as f:
            d = plistlib.load(f)
    except Exception:
        return None
    exe = d.get("CFBundleExecutable")
    return f"Contents/MacOS/{exe}" if exe else None


def bundle_identifier(app):
    plist = Path(app) / "Contents" / "Info.plist"
    if plist.exists():
        try:
            with open(plist, "rb") as f:
                return plistlib.load(f).get("CFBundleIdentifier")
        except Exception:
            pass
    return None


def iter_machos(bundle):
    """Yield absolute paths of every Mach-O file inside a bundle."""
    for dirpath, _dirs, files in os.walk(bundle):
        for name in files:
            fp = Path(dirpath) / name
            if fp.is_symlink() or not fp.is_file():
                continue
            if fp.suffix == ".bak":          # stray pre-translation backups
                continue
            if name in OUR_RUNTIME_LIBS:     # our own support libs, not targets
                continue
            if macho_magic(fp):
                yield fp


def links_our_runtime(macho):
    """True if a binary is one of OUR translation outputs — a translated dylib
    links @loader_path/libabiconv.dylib; a wrapper exec links libinterpose."""
    try:
        o = subprocess.run(["otool", "-L", str(macho)], capture_output=True,
                           text=True, errors="replace")
    except OSError:
        return False
    return "libabiconv.dylib" in o.stdout or "libinterpose.dylib" in o.stdout


def classify(bundle, macho):
    """Decide how to treat a Mach-O, architecture-first.

    A native x86_64 slice is ALWAYS preferred over translating i386: it runs
    directly under Rosetta and (unlike a libabiconv-linked translation) can
    still export its ObjC classes to native frameworks. So we only translate
    when there is no usable native x86_64.

    returns (status, relpath) with status in:
        "fresh"       — i386-only original, never translated → translate
        "retranslate" — our own x86_64 output → re-translate (pick up fixes)
        "native"      — has a real native x86_64 slice → leave it alone
    """
    rel = str(Path(macho).resolve().relative_to(Path(bundle).resolve()))
    archs = archs_of(macho)
    if "x86_64" in archs:
        # Our output AND a backup that still carries an i386 slice to
        # re-translate from → retranslate. (A wrapper's paired <name>.dylib
        # output links our runtime too but has no backup of its own — it's
        # regenerated with the exec, so: native.) If the backup exists but has
        # lost its i386 slice (e.g. a prior run overwrote it with the x86_64
        # output), there is nothing left to translate from → leave the existing
        # x86_64 output in place as native rather than feeding translate-bundle
        # a source with no i386 arch (which exits 1 and would abort the whole
        # bundle's shim+sign deploy).
        bak = backup_root(bundle) / rel
        if links_our_runtime(macho) and bak.exists() and "i386" in archs_of(bak):
            return ("retranslate", rel)
        return ("native", rel)
    if "i386" in archs:
        return ("fresh", rel)
    return ("native", rel)               # arm64 / ppc / unknown → leave alone


# macOS firmlink remaps — symlinks that just prepend /private to the canonical
# path. They are NOT an escape (same logical location), so the in-place guard
# below must not trip on them.
_FIRMLINKS = {"/tmp", "/var", "/etc"}


def _inplace_symlink_escape(target):
    """When translating `target` IN PLACE (no -o/--output), detect whether the
    path reaches its real location THROUGH a symlink — the data-loss trap.

    `Apps32/Civilization IV (Steam).app` and `Apps32/Portal 2` are symlinks into
    the live Steam install; an in-place translate writes THROUGH the link and
    destroys the read-only i386 source (this actually happened — the tester had to
    Steam "Verify integrity of game files" to recover, and even then only the
    main exec came back). `-o <dir>` copies to a fresh tree first, so it is safe.

    Returns (link_path, real_dest) for the SHALLOWEST ESCAPING symlink
    component, or None if the path contains no escaping symlink (safe to write
    in place). A symlink "escapes" only if its real target lands OUTSIDE its own
    parent directory tree — so an intra-bundle link like a framework's
    `Versions/Current -> A` (target stays inside its parent) is NOT flagged; only
    a link that jumps to a different tree (Apps32/<app> -> the Steam install) is."""
    ap = os.path.abspath(target)
    if ap == os.path.realpath(ap):
        return None                      # no symlink anywhere in the path
    cur = os.sep
    for part in Path(ap).parts[1:]:
        cur = os.path.join(cur, part)
        if not os.path.islink(cur) or cur in _FIRMLINKS:
            continue
        parent_real = os.path.realpath(os.path.dirname(cur))
        link_real = os.path.realpath(cur)
        if os.path.commonpath([parent_real, link_real]) != parent_real:
            return (cur, link_real)      # jumps out of its own parent tree
    return None


# ---- commands --------------------------------------------------------------
def cmd_translate(args):
    require(MACHO_TOOL, LIBABICONV, TRANSLATE_BUNDLE)
    target = Path(args.target)
    if not target.exists():
        raise Die(f"no such path: {target}")

    # Data-loss guard: never translate IN PLACE through a symlink (the Steam-
    # install trap above). `-o <dir>` ditto-copies to a fresh tree first, so it
    # is always safe and is exempt. Covers `retranslate` too (it funnels here).
    if not getattr(args, "output", None):
        esc = _inplace_symlink_escape(target)
        if esc:
            link, dest = esc
            raise Die(
                f"refusing to translate in place through a symlink:\n"
                f"    {link}\n"
                f"      -> {dest}\n"
                f"  An in-place translate would write THROUGH the link and "
                f"overwrite that\n  target (e.g. a live Steam install / a "
                f"read-only i386 source).\n"
                f"  Re-run with -o to translate a COPY instead, e.g.:\n"
                f'    m64 translate "{args.target}" -o "$HOME/projects/translations/Apps64"')

    # Bundle vs single binary.
    if target.is_dir():
        if target.suffix not in BUNDLE_SUFFIXES:
            raise Die(f"{target} is a directory but not a bundle "
                      f"({'/'.join(BUNDLE_SUFFIXES)})")
        return translate_bundle(target, args)

    # A file: if it lives inside a bundle, translate it in place; else stand-alone.
    enclosing = find_bundle(target)
    if enclosing:
        rel = str(target.resolve().relative_to(enclosing.resolve()))
        return translate_one(enclosing, rel, args)
    return translate_standalone(target, args)


def translate_one(bundle, rel, args):
    info(f"translate {rel}  (in {Path(bundle).name})")
    cmd = ["bash", TRANSLATE_BUNDLE]
    if args.dry_run: cmd.append("-n")
    if args.keep:    cmd.append("-k")
    cmd += [str(bundle), rel]
    run(cmd, dry=False)   # translate-bundle echoes its own steps


def is_fat(path):
    """True if `path` is a fat/universal Mach-O wrapper (vs. a thin slice)."""
    try:
        with open(path, "rb") as f:
            head = f.read(4)
    except OSError:
        return False
    if len(head) < 4:
        return False
    return struct.unpack(">I", head)[0] in (0xCAFEBABE, 0xBEBAFECA)


def thin_to_i386(binary):
    """The pipeline (86x64.sh / macho-tool) consumes a THIN i386 Mach-O: its
    LC_DYLD_INFO / segment file-offsets are slice-relative, so feeding a fat
    wrapper makes macho-tool read linkedit at the wrong file offset (e.g.
    `BindInfo: invalid bind opcode 0xe0` — bytes past the fat header). If
    `binary` is a fat archive, extract its i386 slice to a temp file and return
    (path, cleanup); otherwise return the input unchanged with a no-op cleanup."""
    if not is_fat(binary):
        return Path(binary), (lambda: None)
    if "i386" not in archs_of(binary):
        return Path(binary), (lambda: None)   # let the pipeline diagnose it
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix="m64-thin-", suffix=".i386")
    os.close(fd)
    info(f"input is fat {archs_of(binary)}; thinning i386 slice -> {tmp}")
    run(["lipo", str(binary), "-thin", "i386", "-output", tmp], dry=False)
    return Path(tmp), (lambda: os.path.exists(tmp) and os.remove(tmp))


def is_macho_dylib(path):
    """True if `path` is a Mach-O dynamic library/bundle (thin OR fat). A dylib
    has no `_main`, so the standalone pipeline must run dylib-only (no exec
    wrapper). `file` reports "shared library" for both thin and fat (the latter
    embeds the slice description)."""
    try:
        o = subprocess.run(["file", "-b", str(path)], capture_output=True,
                           text=True)
        return "shared library" in o.stdout or "bundle" in o.stdout.lower()
    except OSError:
        return False


def translate_standalone(binary, args):
    require(PIPELINE_SH)
    dylib = is_macho_dylib(binary)
    if args.output:
        out = Path(args.output)
    else:
        # dylib -> <name>.x64.dylib (keeps a .dylib extension); exec -> <name>.x64
        out = binary.with_suffix(".x64.dylib") if dylib else binary.with_suffix(".x64")
    info(f"translate (standalone{'/dylib' if dylib else ''}) {binary} -> {out}")
    binary, cleanup = thin_to_i386(binary)
    try:
        cmd = ["bash", PIPELINE_SH, "-m", MACHO_TOOL, "-l", LIBABICONV]
        if args.keep: cmd.append("-k")
        libw = BUILD / "src" / "86x64" / "libwrapper.a"
        libi = BUILD / "src" / "86x64" / "libinterpose.dylib"
        if dylib:
            # dylib-only: -a sets the dylib output path directly (no exec
            # wrapper, no `_main` link). 86x64.sh also auto-detects this, but
            # passing -a gives the exact output name (avoids a double .dylib).
            cmd += ["-a", out, binary]
        else:
            if libw.exists(): cmd += ["-w", libw]
            if libi.exists(): cmd += ["-i", libi]
            cmd += ["-o", out, binary]
        run(cmd, dry=args.dry_run)
    finally:
        cleanup()


def translate_bundle(bundle, args):
    skip = set(args.skip or [])
    only = set(args.only or [])

    # Output-dir mode: with `-o/--output <dir>`, translate a faithful COPY of the
    # source bundle inside <dir> (as <dir>/<bundle>), leaving the source
    # untouched — e.g. read-only Apps32 originals -> Apps64 translated outputs.
    outopt = getattr(args, "output", None)
    if outopt:
        dest = Path(outopt) / Path(bundle).name
        if dest.resolve() != Path(bundle).resolve():
            Path(outopt).mkdir(parents=True, exist_ok=True)
            if dest.exists():
                info(f"output bundle exists, replacing: {dest}")
                shutil.rmtree(dest)
            info(f"copy {Path(bundle).name} -> {dest}  (source untouched)")
            run(["ditto", str(bundle), str(dest)], dry=False)
            # ditto faithfully brings the classic HFS resource forks across, but
            # a bundle containing one cannot be codesigned (and so cannot run on
            # Apple Silicon). Migrate them to data-fork resource files now, so
            # the translated tree is signable from birth and the resources are
            # still readable (rsrc_datafork_shim.c). See flatten_forks().
            flatten_forks(dest, dry_run=False)
            # ditto also brings across the ORIGINAL download's quarantine flag
            # and any fork-less FinderInfo; both make the output unsignable or
            # "damaged" at launch. See strip_signing_blockers().
            strip_signing_blockers(dest)
            bundle = dest

    # Pull in any framework dependency that lives OUTSIDE the bundle (e.g. the
    # iWork '09 shared frameworks) so it gets translated alongside everything
    # else. Skippable with --no-vendor; extra source roots via --source.
    if not getattr(args, "no_vendor", False):
        _vendor(bundle, getattr(args, "source", None) or [], args.dry_run)

    info(f"scanning {Path(bundle).name} for translatable binaries…")
    fresh, retrans, plan_native = [], [], []
    for m in iter_machos(bundle):
        status, rel = classify(bundle, m)
        (fresh if status == "fresh" else
         retrans if status == "retranslate" else plan_native).append(rel)

    # `retranslate` only re-does our own previous outputs; `translate` also
    # picks up i386-only binaries never done before.
    plan_translate = sorted(retrans) if args.retranslate_only \
        else sorted(fresh + retrans)

    # Order: main executable first (it's the debugging anchor).
    main = bundle_executable(bundle)
    if main and main in plan_translate:
        plan_translate.remove(main)
        plan_translate.insert(0, main)

    if only:
        plan_translate = [r for r in plan_translate if r in only]
    if skip:
        for r in list(plan_translate):
            if r in skip:
                plan_translate.remove(r)
                plan_native.append(r)

    print(f"  {len(fresh)} new i386 · {len(retrans)} re-translatable · "
          f"{len(plan_native)} native  →  {len(plan_translate)} selected")
    for r in plan_translate:
        tag = "re" if r in retrans else "new"
        print(f"      • [{tag}] {r}")
    if args.list:
        print("  native (untouched):")
        for r in sorted(plan_native):
            print(f"      - {r}")
        return
    if not plan_translate:
        warn("nothing to translate")
        return

    # Snapshot the main executable's bundled @-relative LC_LOAD_DYLIBs BEFORE the
    # re-emit. A main-exec (re)translate regenerates the wrapper from the i386
    # backup, which carries only the binary's ORIGINAL deps — so any load baked
    # in AFTER deploy (e.g. the FairPlay/geoshim + webnoop anti-tamper shims that
    # MUST be present or iPhoto's dead-handshake VM hangs) is silently dropped.
    # We re-inject whatever went missing after the post-steps run (below). Generic
    # by construction: triggers on "a bundled @-relative load disappeared across
    # re-emit", resolves the file in the bundle, and never names a specific shim.
    wrapper_preserve = (Path(bundle) / main) if (main and main in plan_translate) else None
    preserved_loads = set()
    if wrapper_preserve:
        preserved_loads = {d for d in _dylib_deps(wrapper_preserve)
                           if d.startswith(("@rpath/", "@loader_path/",
                                            "@executable_path/"))}

    # Run translate-bundle for each (optionally in parallel).
    failures = []

    def do(rel):
        cmd = ["bash", TRANSLATE_BUNDLE]
        if args.keep: cmd.append("-k")
        cmd += [str(bundle), rel]
        if args.dry_run:
            print("  dry-run:", " ".join(str(c) for c in cmd))
            return rel, 0, ""
        p = subprocess.run(cmd, capture_output=True, text=True, errors="replace")
        return rel, p.returncode, (p.stdout + p.stderr)

    if args.jobs > 1 and not args.dry_run:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as ex:
            results = list(ex.map(do, plan_translate))
    else:
        results = [do(r) for r in plan_translate]

    for rel, rc, out in results:
        if rc == 0:
            good(rel)
        else:
            failures.append(rel)
            warn(f"FAILED {rel}")
            print("\n".join("      " + l for l in out.splitlines()[-8:]))

    if failures:
        raise Die(f"{len(failures)} binary(ies) failed to translate: "
                  + ", ".join(failures))
    info(f"translated {len(plan_translate)} binaries")

    # Post steps unless suppressed. Order matches `m64 deploy` (rpath → shim →
    # sign). rpath-fix rewrites every absolute LC_LOAD_DYLIB that points at a
    # framework/dylib ACTUALLY bundled in Contents/Frameworks over to @rpath, so
    # the bundle launches WITHOUT a global DYLD_FRAMEWORK_PATH — which otherwise
    # shadows system frameworks' own internal deps with our bundled shims and
    # aborts in native objc-init (0xbad4007 "missing from an installed root",
    # see deploy_rpath_vs_dyld_framework_path). A (re)translate re-emits each
    # binary from its original-ref i386 backup, so the absolute /Library//System
    # refs reappear every run and MUST be re-swept here, not just at first deploy.
    if not getattr(args, "no_rpath", False):
        cmd_rpath_fix(argparse.Namespace(app=str(bundle), dry_run=args.dry_run))
    if not args.no_shim:
        cmd_shim(argparse.Namespace(app=str(bundle), targets=plan_translate,
                                    dry_run=args.dry_run))
    if not args.no_sign:
        cmd_sign(argparse.Namespace(app=str(bundle), dry_run=args.dry_run))

    # Re-inject any bundled @-relative load the wrapper carried before this
    # (re)translate but the regenerated wrapper dropped (see snapshot above). We
    # only re-add a load whose dylib is ACTUALLY present in the bundle, and only
    # when signing ran: macho-tool's insert lays linkedit out correctly on a
    # SIGNED wrapper (inserting into a de-signed one mis-lays __text → SIGILL),
    # so we splice into the just-signed wrapper and re-sign it ad-hoc after.
    if wrapper_preserve and preserved_loads and not args.dry_run:
        if args.no_sign:
            warn("--no-sign: skipping bundled-load re-injection (needs a signed "
                 "wrapper); re-run `m64 sign` then re-add the dropped loads")
        else:
            now = _dylib_deps(wrapper_preserve)
            reinjected = []
            for name in sorted(preserved_loads - now):
                base = name.rsplit("/", 1)[-1]
                if next(Path(bundle).rglob(base), None) is None:
                    warn(f"dropped load {name} not bundled — not re-injecting")
                    continue
                tmp = str(wrapper_preserve) + ".reinject.tmp"
                run([str(MACHO_TOOL), "--", "modify", "--insert",
                     f"load-dylib,name={name}", str(wrapper_preserve), tmp])
                os.chmod(tmp, 0o755)
                os.replace(tmp, wrapper_preserve)
                reinjected.append(name)
            if reinjected:
                run(["codesign", "-f", "-s", "-", str(wrapper_preserve)])
                good("re-injected dropped bundled load(s): " + ", ".join(reinjected))

    info("done. try:  m64 run %s --exc" % Path(bundle).name)


def cmd_retranslate(args):
    args.retranslate_only = True
    args.target = args.app
    cmd_translate(args)


# ⚠DO NOT copy libabiconv.nulljump into a deployed bundle. Two reasons, both
# measured 2026-08-05:
#   * it is UNNECESSARY — static-interpose runs at TRANSLATE time and `m64
#     translate` always passes the BUILD-TREE libabiconv as -l, which sits next
#     to the freshly generated list. No pipeline path ever passes a bundle-local
#     copy.
#   * it BREAKS SIGNING — a stray file at a framework's version root violates the
#     seal: `codesign --verify --deep --strict` then fails with "a sealed
#     resource is missing or invalid / In subcomponent: …QuickTime.framework".
# What DOES need care is the opposite thing: a VENDORED golden framework is a
# translated artifact frozen at whatever commit produced it, so it keeps the
# binds it was translated with. Re-translate those when the core changes; see
# the journal entry for Halo's stale ___ResolveAliasFile.


def cmd_resync(args):
    """Copy the freshly-built libabiconv.dylib over every copy in a bundle."""
    require(LIBABICONV)
    warn_if_build_ambiguous()
    app = Path(args.app)
    copies = list(app.rglob("libabiconv.dylib"))
    # Name the SOURCE, not just the count: "4 copies synced" is exactly the
    # reassuring message you get when you have just deployed the wrong build.
    info(f"resync libabiconv -> {len(copies)} copies in {app.name}")
    info(f"  source: {LIBABICONV}")
    for c in copies:
        if args.dry_run:
            print("  dry-run: cp", LIBABICONV, c)
            continue
        shutil.copy2(LIBABICONV, c)
        subprocess.run(["codesign", "-f", "-s", "-", str(c)],
                       capture_output=True)
        # ⚠A FRAMEWORK SEALS ITS CONTENTS. Replacing a libabiconv copy INSIDE
        # Foo.framework/Versions/A invalidates the FRAMEWORK's signature, not
        # just this file's, and signing the copy alone leaves the framework
        # binary sealed against contents that no longer match. dyld then refuses
        # the whole bundle at launch ("code signature does not cover entire file
        # up to signature") while resync has already printed a cheerful
        # "N copies synced". Re-sign the enclosing framework binary, and say so
        # when that fails instead of hiding it.
        vdir = c.parent
        if vdir.name == "A" and vdir.parent.name == "Versions":
            fw = vdir.parent.parent                      # Foo.framework
            fwbin = vdir / fw.name.replace(".framework", "")
            if fwbin.is_file():
                cs = subprocess.run(["codesign", "-f", "-s", "-", str(fwbin)],
                                    capture_output=True, text=True)
                if cs.returncode != 0:
                    warn(f"codesign FAILED for {fwbin.name}: "
                         f"{cs.stderr.strip().splitlines()[-1:]} -- the bundle "
                         f"will NOT launch until this is resolved")
    if not args.dry_run:
        good(f"{len(copies)} copies synced + ad-hoc signed")
    # The replaced copies invalidate the OUTER bundle seal too. The app still
    # runs locally, but once copied to another Mac (quarantined) Gatekeeper
    # reports "damaged and can't be opened". Re-seal the whole bundle.
    if app.suffix == ".app":
        cmd_sign(args)


def _dylib_deps(macho):
    """Set of LC_LOAD_DYLIB install names of a Mach-O (via `otool -L`). The first
    `otool` line is the file path itself; for an executable every remaining line
    is a load command (executables carry no LC_ID), so this is exact for the
    wrapper. Used to detect bundled @-relative loads that a wrapper re-emit
    silently DROPS (e.g. post-deploy baked-in FairPlay/geoshim shims)."""
    try:
        p = subprocess.run(["otool", "-L", str(macho)],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return set()
    out = set()
    for line in p.stdout.splitlines()[1:]:
        line = line.strip()
        if not line:
            continue
        out.add(line.split(" (", 1)[0].strip())   # drop " (compatibility …)"
    return out


def _native_bound_syms(macho):
    """Symbols a translated binary still imports from a NATIVE framework (i.e.
    NOT already redirected to @loader_path/libabiconv.dylib). These are the
    static-interpose rebind candidates: if libabiconv has since grown a
    `___<sym>` shim, the symbol can now be routed instead of reaching native
    code with the i386 ABI (whose 8-byte ret over-pops the 4-byte i386 ret
    slot -> fused-PC crash). Both bind flavours (lazy = functions, non-lazy =
    data consts) are scanned."""
    out = set()
    for flag in ("--lazy-bind", "--bind"):
        try:
            p = subprocess.run([str(MACHO_TOOL), "print", flag, str(macho)],
                               capture_output=True, text=True, errors="replace")
        except OSError:
            continue
        for line in p.stdout.splitlines()[1:]:
            f = line.split()
            if len(f) < 5:
                continue
            dylib, sym = f[3], f[4]
            if "libabiconv.dylib" not in dylib:   # already-routed → skip
                out.add(sym)
    return out


def cmd_reinterpose(args):
    """Re-run static-interpose against the CURRENT libabiconv for every
    translated binary in a bundle. `resync` only COPIES libabiconv; a binary's
    bind opcodes were frozen at translate time, so a symbol that gained a shim
    AFTER the binary was translated (e.g. the libxml2 family) stays bound to
    its native framework -> over-pop crash. This rebinds such symbols WITHOUT a
    full (heavy) re-translate — the code is unchanged, only __LINKEDIT binds.
    Run it after `m64 build abiconv && m64 resync` whenever libabiconv grew new
    shims that already-deployed bundle binaries should pick up."""
    require(MACHO_TOOL, LIBABICONV)
    app = Path(args.app)
    si = SCRIPT_DIR / "static-interpose.sh"
    require(si)
    env = dict(os.environ,
               PATH=f"{MACHO_TOOL.parent}:{os.environ.get('PATH', '')}")
    info(f"reinterpose translated binaries in {app.name} -> current libabiconv")
    n_bins = 0
    for macho in iter_machos(app):
        if not links_our_runtime(macho):
            continue                              # native / non-output → leave
        syms = _native_bound_syms(macho)
        if not syms:
            continue
        rel = macho.relative_to(app)
        if args.dry_run:
            print(f"  dry-run: reinterpose {rel} ({len(syms)} native syms)")
            continue
        out = macho.with_name(macho.name + ".reint")
        r = subprocess.run(
            [str(si), "-l", str(LIBABICONV), "-n",
             "@loader_path/libabiconv.dylib", "-p", "__", "-o", str(out),
             str(macho)],
            input="\n".join(sorted(syms)), text=True,
            capture_output=True, env=env)
        if r.returncode != 0 or not out.exists():
            warn(f"reinterpose failed for {rel}: {r.stderr.strip().splitlines()[-1:]}")
            if out.exists():
                out.unlink()
            continue
        os.replace(out, macho)
        # ⚠SIGN THE NESTED CODE FIRST, AND CHECK THE RESULT.
        #
        # Rewriting a Mach-O invalidates its signature, so it must be re-signed
        # or dyld refuses to load it ("code signature does not cover entire file
        # up to signature"). For a FRAMEWORK binary that is not enough: codesign
        # walks the version directory and REFUSES the whole operation if a
        # sibling there is unsigned -- "In subcomponent: .../libabiconv.nulljump:
        # code object is not signed at all". This call captured output and
        # ignored the return code, so that refusal was swallowed and the bundle
        # shipped with a stale signature: reinterpose reported "ok" and the app
        # then died in dyld at launch. Sign the neighbours first, and surface a
        # failure instead of hiding it.
        for sib in sorted(macho.parent.glob("libabiconv*")):
            if sib.is_file() and sib != macho:
                subprocess.run(["codesign", "-f", "-s", "-", str(sib)],
                               capture_output=True)
        cs = subprocess.run(["codesign", "-f", "-s", "-", str(macho)],
                            capture_output=True, text=True)
        if cs.returncode != 0:
            warn(f"codesign FAILED for {rel}: "
                 f"{cs.stderr.strip().splitlines()[-1:]} "
                 f"-- the bundle will NOT launch until this is resolved")
        n_bins += 1
        good(f"reinterposed {rel}")
    if not args.dry_run:
        good(f"{n_bins} binaries reinterposed in {app.name}")


# ---- staleness detection ---------------------------------------------------
# The interpose prefix static-interpose.sh prepends to a raw import name to form
# the libabiconv shim export (e.g. _Gestalt -> ___Gestalt, __ZNSt8ios_base…C1Ev
# -> ____ZNSt8ios_base…C1Ev). MUST match static-interpose.sh's `-p "__"`.
INTERPOSE_PREFIX = "__"

# Linker/dyld-SYNTHESIZED special symbols: the runtime-fixup machinery every
# Mach-O carries regardless of what the app imports. They are NEVER part of an
# app's interpose set (the translate pipeline feeds static-interpose the app's
# undefined imports, not these), so a FRESH translation still binds them native
# in __DATA_CONST,__got — confirmed on every deployed target (Halo/iMovie run
# with these native). libabiconv happens to also EXPORT a matching ___-prefixed
# name, but that is a coincidence of naming, not a routing target: rewriting
# `dyld_stub_binder` would break lazy binding outright. Excluded structurally
# (present in ALL images, never an app import) — never keyed on an app name.
#   dyld_stub_binder    — the lazy-bind trampoline helper (BIND_SPECIAL)
#   ___stack_chk_guard  — the stack-protector canary DATA symbol (__got)
LINKER_SYNTHESIZED = frozenset({"dyld_stub_binder", "___stack_chk_guard"})


def _links_libabiconv(macho):
    """True iff a binary links libabiconv.dylib SPECIFICALLY — i.e. it is a
    TRANSLATED BODY whose i386 jump-table binds (__jt_ptrs / __IMPORT,__pointers)
    were routed through static-interpose. This is DELIBERATELY narrower than
    links_our_runtime(): the main-exec WRAPPER links only libinterpose.dylib
    (not libabiconv) and is a pure-native x86_64 launcher — its libc imports sit
    in __DATA_CONST,__got and are called with the native ABI, so binding them
    native is CORRECT (never over-popped). Only libabiconv-linked bodies can be
    stale in the over-pop sense static-interpose guards against."""
    try:
        o = subprocess.run(["otool", "-L", str(macho)], capture_output=True,
                           text=True, errors="replace")
    except OSError:
        return False
    return "libabiconv.dylib" in o.stdout


def _shim_exports(lib):
    """The set of symbols libabiconv currently EXPORTS (defined, external), as
    `nm -gU` prints them — leading underscore(s) intact, exactly the form the
    static-interpose match tests against. This is the authoritative "shimmable
    set": whatever is in here is what a FRESH retranslate would route to."""
    exports = set()
    try:
        p = subprocess.run(["nm", "-gU", str(lib)], capture_output=True,
                           text=True, errors="replace")
    except OSError:
        return exports
    for line in p.stdout.splitlines():
        f = line.split()
        if f:
            exports.add(f[-1])          # `<addr> <type> <name>` → last field
    return exports


def _shim_for(sym, exports):
    """The libabiconv export a raw import `sym` WOULD be routed to, or None if
    libabiconv has no shim for it (→ legitimately left native, NOT stale).

    This mirrors static-interpose.sh's rewrite decision EXACTLY so the detector
    never disagrees with what a real retranslate does — the three acceptance
    rules, in order:
      1. PREFIX+sym is an export           (the normal modern-image case)
      2. PREFIX+base is an export, where base = sym with its `$…` conformance
         suffix stripped (_open$UNIX2003, _stat$INODE64 → same base shim)
      3. sym itself is an export verbatim  (classic already-decorated nlist
         names like ___tolower that libabiconv exports under that exact name)
    """
    cand = INTERPOSE_PREFIX + sym
    if cand in exports:
        return cand
    base = sym.split("$", 1)[0]
    if base != sym:
        cand = INTERPOSE_PREFIX + base
        if cand in exports:
            return cand
    if sym in exports:
        return sym
    return None


def _stale_syms(macho, exports):
    """Stale imports of one translated binary: symbols still bound to a NATIVE
    framework (NOT @loader_path/libabiconv.dylib) for which libabiconv now HAS a
    shim (per _shim_for). Such a binary was translated BEFORE that shim landed —
    the import rename was baked at translate time and a resync won't move it (a
    code-preserving `reinterpose`, or a full retranslate, does).

    Returns a sorted list of (sym, shim_export, native_dylib_leaf). Both bind
    flavours are scanned (lazy = functions, non-lazy = data consts)."""
    hits = {}
    for flag in ("--bind", "--lazy-bind"):
        try:
            p = subprocess.run([str(MACHO_TOOL), "print", flag, str(macho)],
                               capture_output=True, text=True, errors="replace")
        except OSError:
            continue
        for line in p.stdout.splitlines()[1:]:
            f = line.split()
            if len(f) < 5:
                continue
            dylib, sym = f[3], f[4]
            if "libabiconv.dylib" in dylib:          # already routed → not stale
                continue
            if sym in LINKER_SYNTHESIZED:             # runtime-fixup machinery
                continue                              # (never interposed)
            shim = _shim_for(sym, exports)
            if shim and sym not in hits:
                hits[sym] = (shim, dylib.rsplit("/", 1)[-1])
    return sorted((s, v[0], v[1]) for s, v in hits.items())


def cmd_stale_check(args):
    """Find translated binaries that are STALE vs the CURRENT libabiconv shim
    set — i.e. they were translated BEFORE a shim they should use had landed, so
    they still import the RAW native symbol instead of the interposed one.

    Static-interpose bakes the `_X → ___X` rename into a binary's bind opcodes
    at TRANSLATE time, but only for symbols libabiconv shimmed AT THAT MOMENT. A
    binary translated earlier keeps the raw `_X (from <syslib>)`, silently
    reaches native code with the i386 ABI, and over-pops on return — a crash you
    otherwise only find by hitting it (this session: iMovie's HeliumRender kept
    raw std::ios_base::Init until it was retranslated). A `resync` does NOT fix
    these; only a retranslate (or the code-preserving `reinterpose`) does.

    Detection is purely structural — never keyed on an app or symbol name: for
    every translated Mach-O in the bundle, any raw native import whose base name
    HAS a shim in the current libabiconv but wasn't routed to it. Symbols with
    no shim (the ~hundreds of crt/soft-float/C++-runtime externals we correctly
    leave native) are NOT flagged. Exits non-zero iff any staleness is found."""
    lib = Path(args.libabiconv) if args.libabiconv else LIBABICONV
    require(MACHO_TOOL, lib)
    exports = _shim_exports(lib)
    if not exports:
        raise Die(f"no exports read from {lib} — not a libabiconv dylib?")

    target = Path(args.app)
    if not target.exists():
        raise Die(f"no such path: {target}")

    # A loose Mach-O binary, or a whole bundle.
    if target.is_file():
        machos = [target]
        base = target.parent
    else:
        machos = list(iter_machos(target))
        base = target

    quiet = getattr(args, "quiet", False)
    if not quiet:
        info(f"stale-check {Path(target).name}  vs {lib.name} "
             f"({len(exports)} exports)")

    n_scanned = 0
    stale_bins = []                                  # (rel, [(sym, shim, dylib)])
    for m in machos:
        if not _links_libabiconv(m):                 # native / wrapper → skip
            continue
        n_scanned += 1
        stale = _stale_syms(m, exports)
        if stale:
            try:
                rel = str(m.resolve().relative_to(Path(base).resolve()))
            except ValueError:
                rel = m.name
            stale_bins.append((rel, stale))

    total_syms = sum(len(s) for _, s in stale_bins)
    for rel, stale in sorted(stale_bins):
        print(f"\033[1;33mSTALE\033[0m {rel}  ({len(stale)} symbol(s) predate "
              f"their shim — retranslate)")
        if not quiet:
            for sym, shim, dylib in stale:
                print(f"        {sym}  (shim {shim} available; still native "
                      f"from {dylib})")

    if stale_bins:
        print(f"\033[1;33m==>\033[0m {len(stale_bins)}/{n_scanned} translated "
              f"binary(ies) STALE, {total_syms} symbol(s) — "
              f"`m64 retranslate {Path(target).name}` "
              f"(or `m64 reinterpose` to rebind without re-translating)")
        return 1
    good(f"{n_scanned} translated binary(ies) scanned — none stale "
         f"(all shimmable imports routed to libabiconv)")
    return 0


def _find_libinterpose():
    """The runtime interpose helper, wherever the build put it."""
    for c in (BUILD / "src" / "abiconv" / "libinterpose.dylib",
              BUILD / "src" / "86x64" / "libinterpose.dylib"):
        if c.exists():
            return c
    return None


def _rsrc_fork_size(path):
    """Size of a file's classic Mac resource fork (0 = none). APFS/HFS+ expose
    the fork as the virtual child path <file>/..namedfork/rsrc."""
    try:
        return os.stat(str(path) + "/..namedfork/rsrc").st_size
    except OSError:
        return 0


RSRC_SIDECAR_DIR = ".86x64rsrc"


def flatten_forks(app, dry_run=False, verbose=True):
    """Migrate classic HFS resource forks to codesign-safe DATA-fork resource files.

    THE CONFLICT (structural, hits every classic-era target):
      * a classic resource file (`*.rsrc`, DLOG/DITL/TEXT/'styl' …) keeps its
        entire payload in the HFS RESOURCE FORK; its data fork is 0 bytes;
      * modern `codesign` refuses to sign ANY bundle containing a resource fork —
            App.app: resource fork, Finder information, or similar detritus not allowed
        (exit 1) — and on Apple Silicon an unsigned bundle cannot launch.
      A translated bundle therefore cannot keep its forks AND be runnable, and
      stripping them leaves a 0-byte husk whose resources vanish silently
      (FSOpenResFile -> -1, Get1Resource -> NULL; e.g. Halo's first-launch EULA
      dialog is built, finds no 'TEXT' 1024, and exit()s).

    THE MIGRATION (Apple's own `.dfont` model — the modern Resource Manager reads
    a resource map out of the DATA fork via FSOpenResourceFile):
      * data fork empty  -> the fork bytes BECOME the file (flatten in place);
      * data fork in use  -> the fork bytes go to the hidden sidecar
                             <dir>/.86x64rsrc/<name>, so nothing is ever lost.
    Either way the fork + FinderInfo xattrs are removed, so the bundle signs.
    `src/abiconv/rsrc_datafork_shim.c` makes FSOpenResFile look in both places.

    Idempotent: a bundle with no resource forks left is a no-op.
    """
    app = Path(app)
    flat = side = 0
    for f in sorted(p for p in app.rglob("*") if p.is_file() and not p.is_symlink()):
        if f.parent.name == RSRC_SIDECAR_DIR:
            continue
        n = _rsrc_fork_size(f)
        if not n:
            continue
        data_sz = f.stat().st_size
        if data_sz == 0:
            dest, kind = f, "data fork"
        else:
            dest = f.parent / RSRC_SIDECAR_DIR / f.name
            kind = "sidecar"
        if verbose:
            info(f"flatten fork {f.relative_to(app)}  ({n} bytes -> {kind})")
        if dry_run:
            continue
        with open(str(f) + "/..namedfork/rsrc", "rb") as i:
            blob = i.read()
        if len(blob) != n:
            raise Die(f"short read of resource fork: {f}")
        if dest is not f:
            dest.parent.mkdir(parents=True, exist_ok=True)
        # Write the payload BEFORE dropping the fork, so a failure never loses it.
        tmp = dest.parent / (dest.name + ".86x64tmp")
        with open(tmp, "wb") as o:
            o.write(blob)
        shutil.copymode(f, tmp)          # keep the classic file's mode bits
        os.replace(tmp, dest)
        for attr in ("com.apple.ResourceFork", "com.apple.FinderInfo"):
            subprocess.run(["xattr", "-d", attr, str(f)], capture_output=True)
        if _rsrc_fork_size(f):
            raise Die(f"could not remove resource fork: {f}")
        if kind == "data fork":
            flat += 1
        else:
            side += 1
    if verbose and (flat or side):
        good(f"forks flattened: {flat} into the data fork, {side} into "
             f"{RSRC_SIDECAR_DIR}/ sidecars")
    return flat + side


def cmd_forks(args):
    """List / restore / flatten classic Mac RESOURCE FORKS in a bundle.

    Old bundles store real data in the resource fork (classic Resource Manager
    files like *.rsrc DLOG/DITL/TEXT dialogs, QuickTime ref movies, ...). The
    fork travels as the com.apple.ResourceFork xattr; plain `cp`/`shutil` copies
    DROP it, leaving a 0-byte data-fork husk the app silently fails to load.
    (`ditto` — used by `m64 translate -o` since d5da653 — preserves forks, so
    this repairs bundles deployed before that, or copied by other tools.)

    m64 forks App.app                 -> list fork-carrying files
    m64 forks App.app --from Orig.app -> restore missing/short forks (+ the
                                         com.apple.FinderInfo type/creator
                                         xattr) from the original bundle
    m64 forks App.app --flatten       -> migrate every remaining fork to a
                                         codesign-safe data-fork resource file
                                         (see flatten_forks(); runs
                                         automatically at translate + sign)

    A full repair of a bundle whose forks were stripped is therefore:
        m64 forks App.app --from Orig.app && m64 forks App.app --flatten
    (or simply re-sign it — `m64 sign` flattens first).
    """
    app = Path(args.app)
    if not app.exists():
        raise Die(f"no such bundle: {app}")

    if args.flatten and not args.source:
        flatten_forks(app, dry_run=args.dry_run)
        return

    if not args.source:                                   # list mode
        n = 0
        for f in sorted(p for p in app.rglob("*") if p.is_file()):
            sz = _rsrc_fork_size(f)
            if sz:
                print(f"  {sz:>10}  {f.relative_to(app)}")
                n += 1
        good(f"{n} file(s) carry a resource fork")
        return

    src_app = Path(args.source)
    require(src_app)
    fixed = skipped = missing = 0
    for src in sorted(p for p in src_app.rglob("*") if p.is_file()):
        want = _rsrc_fork_size(src)
        if not want:
            continue
        dst = app / src.relative_to(src_app)
        if not dst.is_file():
            warn(f"not in target bundle, skipping: {dst.relative_to(app)}")
            missing += 1
            continue
        have = _rsrc_fork_size(dst)
        if have == want:
            skipped += 1
            continue
        # Already migrated by flatten_forks()? The payload is in the data fork
        # (data-fork resource file) or the .86x64rsrc sidecar — restoring the HFS
        # fork on top of that would only make the bundle unsignable again.
        if dst.stat().st_size == want or \
           (dst.parent / RSRC_SIDECAR_DIR / dst.name).is_file():
            skipped += 1
            continue
        info(f"restore fork {src.relative_to(src_app)}  ({have} -> {want} bytes)")
        if args.dry_run:
            continue
        with open(str(src) + "/..namedfork/rsrc", "rb") as i, \
             open(str(dst) + "/..namedfork/rsrc", "wb") as o:
            shutil.copyfileobj(i, o)
        # FinderInfo (classic type/creator codes) rides along for fidelity.
        p = subprocess.run(["xattr", "-px", "com.apple.FinderInfo", str(src)],
                           capture_output=True, text=True)
        if p.returncode == 0 and p.stdout.strip():
            subprocess.run(["xattr", "-wx", "com.apple.FinderInfo",
                            p.stdout.strip(), str(dst)], capture_output=True)
        if _rsrc_fork_size(dst) != want:
            raise Die(f"fork restore failed for {dst}")
        fixed += 1
    good(f"forks: {fixed} restored, {skipped} already ok, {missing} absent from target")
    if args.flatten:
        flatten_forks(app, dry_run=args.dry_run)


def cmd_tree(args):
    """Translate a NON-bundle directory tree of i386 binaries (e.g. a Source-
    engine game like Portal 2) into x86_64.

    Trees differ from .app bundles in two ways the bundle path can't model:
    there is no Info.plist, and the common Source layout keeps the i386 build in
    one dir (`bin/osx32`) while expecting the x86_64 build in a sibling
    (`bin/osx64`), with the embedded runtime module paths byte-patched
    osx32->osx64. This command captures that workflow generically — nothing here
    is Source-specific beyond the path strings you pass:

        m64 tree "<gameroot>" --src bin/osx32 --out bin/osx64 \\
                 --exec portal2_osx --skip libcef.dylib --patch

    With no --src/--out it simply translates every i386 Mach-O under <root> in
    place (the plain-directory case). Each binary goes through the same
    standalone pipeline as `m64 translate <file> -o <out>`.
    """
    require(PIPELINE_SH, LIBABICONV)
    root = Path(args.root).resolve()
    if not root.is_dir():
        sys.exit(f"m64 tree: {root} is not a directory")
    src_dir = (root / args.src) if args.src else root
    out_dir = (root / args.out) if args.out else src_dir
    if not src_dir.is_dir():
        sys.exit(f"m64 tree: source dir {src_dir} does not exist")
    skip = set(args.skip or [])

    # Targets: every i386 Mach-O under src_dir (relative layout preserved into
    # out_dir), plus any explicit root-level executables (--exec).
    targets = []                                   # [(input, output)]
    for m in sorted(src_dir.rglob("*")):
        if m.is_symlink() or not m.is_file() or not macho_magic(m):
            continue
        if m.name in skip or m.name in OUR_RUNTIME_LIBS:
            continue
        if "i386" not in archs_of(m):
            continue                               # native/other → leave alone
        targets.append((m, out_dir / m.relative_to(src_dir)))
    for name in (args.exec or []):
        e = root / name
        if not (e.is_file() and macho_magic(e)):
            warn(f"--exec {name}: not a Mach-O at {e}")
            continue
        targets.append((e, out_dir / name))

    if args.list:
        info(f"tree {root.name}: {len(targets)} i386 binaries → {out_dir}")
        for i, o in targets:
            print(f"  {i.relative_to(root)} → {o.relative_to(root)}")
        return

    info(f"tree {root.name}: translating {len(targets)} i386 binaries  "
         f"{src_dir.relative_to(root) if src_dir != root else '.'} → "
         f"{out_dir.relative_to(root) if out_dir != root else '.'}")
    if not args.dry_run:
        out_dir.mkdir(parents=True, exist_ok=True)

    ok = 0
    failures = []
    for inp, outp in targets:
        if not args.dry_run:
            outp.parent.mkdir(parents=True, exist_ok=True)
        ns = argparse.Namespace(output=str(outp), keep=args.keep,
                                dry_run=args.dry_run)
        try:
            translate_standalone(inp, ns)
            ok += 1
        except Exception as e:                     # keep going; report at the end
            failures.append((inp.name, e))
            warn(f"FAIL {inp.name}: {e}")
    info(f"translated ok={ok} fail={len(failures)}")
    if args.dry_run:
        return

    # Runtime support libs alongside the outputs (translated binaries load
    # libabiconv via @loader_path / leafname).
    if not args.no_runtime:
        libs = [LIBABICONV]
        li = _find_libinterpose()
        if li:
            libs.append(li)
        for lib in libs:
            dst = out_dir / Path(lib).name
            shutil.copy2(lib, dst)
            subprocess.run(["codesign", "-f", "-s", "-", str(dst)],
                           capture_output=True)
        good(f"copied {len(libs)} runtime lib(s) → {out_dir.relative_to(root)}")

    # Equal-length path byte-patch (Source binaries build absolute module paths
    # from the embedded literal — rewrite bin/osx32 → bin/osx64 in place).
    if args.patch:
        if not (args.src and args.out):
            warn("--patch needs both --src and --out; skipping")
        elif len(args.src) != len(args.out):
            warn(f"--patch needs equal-length --src/--out "
                 f"({args.src!r} vs {args.out!r}); skipping")
        else:
            a, b = args.src.encode(), args.out.encode()
            n = 0
            for f in sorted(out_dir.rglob("*")):
                if not f.is_file() or f.is_symlink() or not macho_magic(f):
                    continue
                data = f.read_bytes()
                if a in data:
                    f.write_bytes(data.replace(a, b))
                    n += 1
            good(f"byte-patched {args.src} → {args.out} in {n} binaries")

    # Ad-hoc re-sign every output (MACHO_HEADERPAD reserves header room so the
    # signature can't clobber __text). Patching/copying invalidated them.
    nsign = 0
    for f in sorted(out_dir.rglob("*")):
        if f.is_file() and not f.is_symlink() and macho_magic(f):
            subprocess.run(["codesign", "-f", "-s", "-", str(f)],
                           capture_output=True)
            nsign += 1
    good(f"ad-hoc signed {nsign} binaries in {out_dir.relative_to(root)}")

    if failures:
        warn(f"{len(failures)} translation failure(s): "
             + ", ".join(n for n, _ in failures))
    exe = (args.exec or [None])[0]
    if exe:
        rel = (out_dir / exe).relative_to(root)
        info(f"run:  cd {str(root)!r} ; "
             f'DYLD_LIBRARY_PATH="$PWD/{out_dir.relative_to(root)}" ./{rel}')


def cmd_rpath_fix(args):
    require(RPATH_SWEEP)
    info(f"rpath sweep {Path(args.app).name}")
    run(["python3", RPATH_SWEEP, args.app], dry=args.dry_run)


def _vendor(bundle, sources, dry):
    """Copy missing external framework deps into the bundle (best-effort)."""
    require(VENDOR_DEPS)
    cmd = ["python3", VENDOR_DEPS, str(bundle)]
    for s in sources:
        cmd += ["--source", s]
    if dry:
        cmd.append("--dry-run")
    run(cmd, dry=False, check=False)   # the script prints its own steps


def cmd_vendor(args):
    _vendor(Path(args.app), args.source or [], args.dry_run)


def cmd_shim(args):
    require(SHIMGEN)
    target = Path(args.app)
    if not target.exists():
        raise Die(f"no such path: {target}")
    extra = ["--scan-only"] if getattr(args, "scan_only", False) else []
    # A loose Mach-O binary: shimgen shims it directly (shims land beside it).
    if target.is_file():
        info(f"shimgen {target.name}  (standalone binary)")
        run(["python3", SHIMGEN, *extra, str(target)], dry=args.dry_run)
        return
    translated_only = getattr(args, "translated_only", False)
    targets = list(getattr(args, "targets", None) or [])
    if not targets:
        targets = _discover_shim_targets(target, translated_only=translated_only)
    info(f"shimgen {target.name}  ({len(targets)} "
         f"{'translated' if translated_only else 'x86_64'} target(s))")
    if not targets:
        warn("no shim targets found")
        return
    run(["python3", SHIMGEN, *extra, str(target), *targets], dry=args.dry_run)


def _discover_shim_targets(app, translated_only=False):
    """Bundle binaries that may need native-symbol shims. By DEFAULT every
    x86_64 Mach-O — a NATIVE app built against an older SDK binds AppKit (etc.)
    symbols deleted since, not just our translated outputs. `translated_only`
    restricts to our libabiconv-linked translations (the post-translate path)."""
    app = Path(app)
    out = []
    for m in iter_machos(app):
        if "x86_64" not in archs_of(m):
            continue
        if translated_only and not links_our_runtime(m):
            continue
        out.append(str(m.resolve().relative_to(app.resolve())))
    return sorted(out)


def _strip_native_execution(app):
    """Remove LSRequiresNativeExecution from a translated app's Info.plist.
    Intel-era apps (iMovie '11, …) set it to force x86_64-native and avoid
    PPC-via-Rosetta. On Apple Silicon "native" means arm64, so LaunchServices
    refuses to launch our x86_64 (Rosetta) executable and Finder/`open` fails
    with "The application cannot be opened because it has an incorrect executable
    format." A translated bundle always runs x86_64 under Rosetta, so the key is
    never appropriate — strip it so the app is Finder-launchable. Idempotent."""
    ip = Path(app) / "Contents" / "Info.plist"
    try:
        with open(ip, "rb") as f:
            d = plistlib.load(f)
    except Exception:
        return
    if d.pop("LSRequiresNativeExecution", None) is not None:
        with open(ip, "wb") as f:
            plistlib.dump(d, f)
        info("  stripped LSRequiresNativeExecution (Finder-launchable under Rosetta)")


def strip_signing_blockers(app, verbose=True):
    """Remove the xattrs that make a COPIED bundle unsignable or unopenable.

    Two structural leftovers of copying someone else's bundle, neither of which
    flatten_forks() covers (it only touches files that carry a RESOURCE FORK):

      * `com.apple.FinderInfo` on a file with NO fork — the classic type/creator
        (e.g. `TEXT!Rch` on a .plist). codesign refuses the whole bundle:
        "resource fork, Finder information, or similar detritus not allowed",
        so `--deep` signing fails and the bundle cannot run on Apple Silicon.
      * `com.apple.quarantine` — inherited from however the ORIGINAL app was
        downloaded (Quinn's says `Chrome`) and faithfully copied by ditto. On an
        ad-hoc signed bundle Gatekeeper turns it into
        "<App> is damaged and can't be opened", with no hint that an xattr is
        the cause. A locally built translation is not a download, so the flag is
        simply wrong on the output.

    MEASURED 2026-09-23: Quinn.app carried 536 quarantined files plus one
    FinderInfo plist; clearing both and re-signing made it launch again.
    Idempotent, and a no-op on a clean bundle.
    """
    app = Path(app)
    fi = [f for f in app.rglob("*")
          if f.is_file() and not f.is_symlink()
          and b"com.apple.FinderInfo" in subprocess.run(
              ["xattr", str(f)], capture_output=True).stdout]
    for f in fi:
        subprocess.run(["xattr", "-d", "com.apple.FinderInfo", str(f)],
                       capture_output=True)
    q = subprocess.run(["xattr", "-r", "-d", "com.apple.quarantine", str(app)],
                       capture_output=True)
    if verbose and (fi or q.returncode == 0):
        good(f"stripped signing blockers: {len(fi)} FinderInfo xattr(s), "
             f"quarantine cleared")
    return len(fi)


def cmd_sign(args):
    require(FIX_SIGNING)
    app = Path(args.app)
    ident = bundle_identifier(app) or app.stem
    info(f"sign {app.name}  (identifier {ident})")
    # flat-sign loose dylibs, fix nested signing, then the outer bundle.
    # codesign refuses to sign a bundle that still carries an HFS resource fork
    # ("resource fork, Finder information, or similar detritus not allowed",
    # exit 1). Migrate them to data-fork resource files FIRST so the classic
    # resources survive instead of being stripped away (flatten_forks()).
    flatten_forks(app, dry_run=args.dry_run)
    if not args.dry_run:
        strip_signing_blockers(app)
        _strip_native_execution(app)
        for d in (app / "Contents" / "Frameworks").glob("*.dylib"):
            subprocess.run(["codesign", "-f", "-s", "-", str(d)],
                           capture_output=True)
    run(["python3", FIX_SIGNING, str(app)], dry=args.dry_run, check=False)
    run(["codesign", "-f", "-s", "-", "--identifier", ident, str(app)],
        dry=args.dry_run, check=False)


def cmd_deploy(args):
    """Full post-translate deploy (rpath → shim → resync → sign → clear state)."""
    require(DEPLOY_SH)
    app = Path(args.app)
    ident = args.identifier or bundle_identifier(app) or app.stem
    savedstate = args.savedstate or bundle_identifier(app) or ""
    # Build a transient targets file from auto-discovery unless one is given.
    if args.targets_file:
        targets_file = args.targets_file
        cleanup = None
    else:
        import tempfile
        tf = tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False)
        for t in _discover_shim_targets(app):
            tf.write(t + "\n")
        tf.close()
        targets_file = tf.name
        cleanup = tf.name
    info(f"deploy {app.name}  id={ident} savedState={savedstate or '(none)'}")
    try:
        run(["bash", DEPLOY_SH, str(app), ident, targets_file, savedstate],
            dry=args.dry_run, check=False)
    finally:
        if cleanup and not args.dry_run:
            os.unlink(cleanup)


def cmd_run(args):
    app = Path(args.app)
    rel = bundle_executable(app) if app.is_dir() else None
    exe = (app / rel) if rel else app
    if not exe.exists():
        raise Die(f"executable not found: {exe}")
    macos_dir = exe.parent
    env = dict(os.environ)
    if args.trace:
        env["OBJC_BRIDGE_TRACE"] = "1"

    if args.no_lldb:
        info(f"run {exe.name}")
        run([f"./{exe.name}"], cwd=macos_dir, env=env, check=False)
        return

    # lldb batch with a watchdog so a hung modal/event-loop can't wedge us.
    info(f"run {exe.name} under lldb (timeout {args.timeout}s, "
         f"{'exc-trace ' if args.exc else ''}{'bridge-trace' if args.trace else ''})")
    lldb_cmd = ["/usr/bin/lldb", "-b"]
    if args.exc:
        require(LLDB_EXC)
        lldb_cmd += ["-o", f"command script import {LLDB_EXC}"]
    lldb_cmd += ["-o", "run",
                 "-k", "script t=lldb.process.GetSelectedThread(); "
                       "print('### STOP', t.GetStopDescription(400))",
                 "-k", "bt 24", "-k", "quit", f"./{exe.name}"]
    if args.dry_run:
        print("  dry-run:", " ".join(lldb_cmd))
        return
    proc = subprocess.Popen(lldb_cmd, cwd=macos_dir, env=env)
    try:
        proc.wait(timeout=args.timeout)
    except subprocess.TimeoutExpired:
        warn(f"timeout ({args.timeout}s) — killing")
        subprocess.run(["pkill", "-9", "-f", f"MacOS/{exe.name}"],
                       capture_output=True)
        proc.kill()


def cmd_build(args):
    require(BUILD / "CMakeCache.txt")
    target = args.target
    cmd = ["cmake", "--build", str(BUILD)]
    if target and target != "all":
        cmd += ["--target", target]
    if args.jobs > 1:
        cmd += ["-j", str(args.jobs)]
    info(f"build {target or 'all'}")
    run(cmd, dry=args.dry_run, check=True)
    if args.resync:
        cmd_resync(argparse.Namespace(app=args.resync, dry_run=args.dry_run))


def cmd_macho(args):
    require(MACHO_TOOL)
    os.execv(str(MACHO_TOOL), [str(MACHO_TOOL), *args.rest])


# ---- argument parser -------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(
        prog="m64", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", metavar="<command>", required=True)

    def common(sp):
        sp.add_argument("-n", "--dry-run", action="store_true",
                        help="print actions without modifying anything")

    # translate
    t = sub.add_parser("translate", help="translate a binary or a whole bundle")
    t.add_argument("target", help="an .app/.framework bundle, or a Mach-O file")
    t.add_argument("-o", "--output", help="output path: a FILE (standalone-binary mode) "
                   "or a DIRECTORY (bundle mode — translate a copy in <dir>/<bundle>, "
                   "leaving the source untouched; e.g. Apps32 -> Apps64)")
    t.add_argument("--only", action="append", metavar="RELPATH",
                   help="bundle mode: only translate these relpaths (repeatable)")
    t.add_argument("--skip", action="append", metavar="RELPATH",
                   help="bundle mode: leave these binaries native (repeatable)")
    t.add_argument("--no-vendor", action="store_true",
                   help="skip pulling missing external framework deps into the bundle")
    t.add_argument("--source", action="append", metavar="DIR",
                   help="extra dir to search for original frameworks to vendor "
                        "(repeatable)")
    t.add_argument("--no-shim", action="store_true",
                   help="skip shimgen after translating the bundle")
    t.add_argument("--no-sign", action="store_true",
                   help="skip code-signing after translating the bundle")
    t.add_argument("--no-rpath", action="store_true",
                   help="skip the @rpath sweep (rewrite bundled-framework refs)")
    t.add_argument("--list", action="store_true",
                   help="just list what would be translated vs left native")
    t.add_argument("-j", "--jobs", type=int, default=1,
                   help="parallel binary translations (bundle mode)")
    t.add_argument("-k", "--keep", action="store_true",
                   help="keep intermediate tempdirs")
    t.set_defaults(retranslate_only=False)
    common(t); t.set_defaults(func=cmd_translate)

    # retranslate
    r = sub.add_parser("retranslate",
                       help="re-translate a bundle's already-translated binaries "
                            "(after a translator fix)")
    r.add_argument("app", help="the .app/.framework bundle")
    r.add_argument("--only", action="append", metavar="RELPATH")
    r.add_argument("--skip", action="append", metavar="RELPATH")
    r.add_argument("--no-vendor", action="store_true")
    r.add_argument("--source", action="append", metavar="DIR")
    r.add_argument("--no-shim", action="store_true")
    r.add_argument("--no-sign", action="store_true")
    r.add_argument("--no-rpath", action="store_true")
    r.add_argument("--list", action="store_true")
    r.add_argument("-j", "--jobs", type=int, default=1)
    r.add_argument("-k", "--keep", action="store_true")
    r.set_defaults(output=None)
    common(r); r.set_defaults(func=cmd_retranslate)

    # resync
    s = sub.add_parser("resync",
                       help="copy the freshly-built libabiconv.dylib over every "
                            "copy inside a bundle (+ ad-hoc sign)")
    s.add_argument("app")
    common(s); s.set_defaults(func=cmd_resync)

    # forks
    fk = sub.add_parser("forks",
                        help="list / restore classic Mac resource forks in a "
                             "bundle (old copy steps dropped them; data like "
                             "*.rsrc dialogs lives ONLY in the fork)")
    fk.add_argument("app", help="the (deployed) bundle to inspect/repair")
    fk.add_argument("--from", dest="source", metavar="ORIG",
                    help="original bundle to restore missing forks from")
    fk.add_argument("--flatten", action="store_true",
                    help="migrate every resource fork to a codesign-safe "
                         "data-fork resource file (data fork if empty, else a "
                         "hidden .86x64rsrc sidecar); runs automatically at "
                         "translate + sign")
    common(fk); fk.set_defaults(func=cmd_forks)

    # reinterpose
    ri = sub.add_parser("reinterpose",
                        help="re-run static-interpose on every translated binary "
                             "in a bundle against the current libabiconv (picks up "
                             "newly-added shims without a heavy re-translate)")
    ri.add_argument("app")
    common(ri); ri.set_defaults(func=cmd_reinterpose)

    # stale-check
    sc = sub.add_parser(
        "stale-check",
        help="find translated binaries STALE vs the current libabiconv: raw "
             "native imports that now HAVE a shim but were translated before it "
             "landed (silent over-pop crashes). Exits non-zero if any are found.")
    sc.add_argument("app", help="an .app/.framework bundle, or a single Mach-O binary")
    sc.add_argument("--libabiconv", metavar="DYLIB",
                    help="libabiconv to treat as the current shim set "
                         "(default: the freshly-built build/…/libabiconv.dylib, "
                         "i.e. what a retranslate would route to)")
    sc.add_argument("-q", "--quiet", action="store_true",
                    help="only the STALE binary lines + summary (no per-symbol detail)")
    common(sc); sc.set_defaults(func=cmd_stale_check)

    # tree (non-bundle directory trees, e.g. Source-engine games)
    tr = sub.add_parser(
        "tree",
        help="translate a non-bundle directory tree (e.g. a Source-engine game "
             "like Portal 2): out-of-place src→out, runtime copy, path patch, sign")
    tr.add_argument("root", help="the project root directory (e.g. the gameroot)")
    tr.add_argument("--src", metavar="SUBDIR",
                    help="subdir of i386 inputs, relative to root (e.g. bin/osx32). "
                         "Default: translate in place under root.")
    tr.add_argument("--out", metavar="SUBDIR",
                    help="subdir for x86_64 outputs (e.g. bin/osx64). "
                         "Default: same as --src (in place).")
    tr.add_argument("--exec", action="append", metavar="NAME",
                    help="a root-level executable to also translate (repeatable)")
    tr.add_argument("--skip", action="append", metavar="NAME",
                    help="leaf names to leave untranslated (repeatable)")
    tr.add_argument("--patch", action="store_true",
                    help="equal-length byte-patch of the --src string → the --out "
                         "string in outputs (Source binaries embed bin/osx32 paths)")
    tr.add_argument("--no-runtime", action="store_true",
                    help="don't copy libabiconv/libinterpose into the out dir")
    tr.add_argument("--list", action="store_true",
                    help="just list what would be translated")
    tr.add_argument("-k", "--keep", action="store_true",
                    help="keep intermediate tempdirs")
    common(tr); tr.set_defaults(func=cmd_tree)

    # rpath-fix
    rp = sub.add_parser("rpath-fix", help="sweep/repair @rpath load commands")
    rp.add_argument("app")
    common(rp); rp.set_defaults(func=cmd_rpath_fix)

    # vendor
    ve = sub.add_parser("vendor",
                        help="copy missing external framework deps into a bundle "
                             "(walks the dependency closure, pulls originals from "
                             "source roots)")
    ve.add_argument("app")
    ve.add_argument("--source", action="append", metavar="DIR",
                    help="extra dir to search for original frameworks (repeatable)")
    common(ve); ve.set_defaults(func=cmd_vendor)

    # shim
    sh = sub.add_parser(
        "shim",
        help="shim missing native symbols (shimgen) for a bundle OR a loose "
             "binary — e.g. AppKit symbols deleted since the app's SDK")
    sh.add_argument("app", help="an .app/.framework bundle, or a single Mach-O binary")
    sh.add_argument("targets", nargs="*",
                    help="bundle mode: binary relpaths to shim "
                         "(default: every x86_64 binary)")
    sh.add_argument("--translated-only", action="store_true",
                    help="bundle mode: only shim our libabiconv-linked "
                         "translations, not native binaries")
    sh.add_argument("--scan-only", action="store_true",
                    help="report missing symbols + coverage; write nothing")
    common(sh); sh.set_defaults(func=cmd_shim)

    # sign
    sg = sub.add_parser("sign", help="fix nested signing + ad-hoc codesign a bundle")
    sg.add_argument("app")
    common(sg); sg.set_defaults(func=cmd_sign)

    # deploy
    dp = sub.add_parser("deploy",
                        help="full post-translate deploy: rpath→shim→resync→sign"
                             "→clear saved state")
    dp.add_argument("app")
    dp.add_argument("--identifier", help="codesign identifier (default: bundle id)")
    dp.add_argument("--targets-file", help="shimgen targets file (default: auto)")
    dp.add_argument("--savedstate", help="saved-state id to clear (default: bundle id)")
    common(dp); dp.set_defaults(func=cmd_deploy)

    # run
    ru = sub.add_parser("run", help="launch a translated app (optionally under lldb)")
    ru.add_argument("app")
    ru.add_argument("--exc", action="store_true",
                    help="import the ObjC-exception tracer under lldb")
    ru.add_argument("--trace", action="store_true",
                    help="set OBJC_BRIDGE_TRACE=1")
    ru.add_argument("--no-lldb", action="store_true",
                    help="run the binary directly, no debugger")
    ru.add_argument("--timeout", type=int, default=120,
                    help="watchdog timeout in seconds (default 120)")
    common(ru); ru.set_defaults(func=cmd_run)

    # debug (alias: run --exc)
    db = sub.add_parser("debug", help="alias for `run --exc` (trap ObjC exceptions)")
    db.add_argument("app")
    db.add_argument("--trace", action="store_true")
    db.add_argument("--timeout", type=int, default=120)
    common(db)
    db.set_defaults(func=lambda a: cmd_run(argparse.Namespace(
        app=a.app, exc=True, trace=a.trace, no_lldb=False,
        timeout=a.timeout, dry_run=a.dry_run)))

    # build
    b = sub.add_parser("build", help="cmake build the project / a target")
    b.add_argument("target", nargs="?", default="all",
                   help="all (default) | abiconv | macho-tool | …")
    b.add_argument("-j", "--jobs", type=int, default=os.cpu_count() or 4)
    b.add_argument("--resync", metavar="APP",
                   help="after building, resync libabiconv into this bundle")
    common(b); b.set_defaults(func=cmd_build)

    # macho (passthrough)
    m = sub.add_parser("macho", help="passthrough to the low-level macho-tool engine")
    m.add_argument("rest", nargs=argparse.REMAINDER,
                   help="arguments forwarded verbatim to macho-tool")
    m.set_defaults(func=cmd_macho)

    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        # Commands may return an int exit status (e.g. stale-check → non-zero
        # when it finds staleness, for CI/scripts). None/0 → success.
        rc = args.func(args)
        return rc or 0
    except Die as e:
        print(f"\033[1;31mm64: {e}\033[0m", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    except subprocess.CalledProcessError as e:
        print(f"\033[1;31mm64: command failed ({e.returncode}): "
              f"{' '.join(map(str, e.cmd))}\033[0m", file=sys.stderr)
        return e.returncode or 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
