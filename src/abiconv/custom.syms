# CFBundleGetFunctionPointerForName (posix_shim.c) — the CF analogue of dlsym:
# returns a native function pointer the i386 caller calls directly. abigen's
# bridge returned the >4GB pointer untruncated-but-unwrapped, so the i386 caller
# truncated it to 32 bits and jumped to garbage (Civ IV GetBSDProcAddress ->
# internal_chdir "chdir"). Hand-shimmed to wrap the result in a low-4GB callable
# thunk (dlsym_make_thunk). Excluded here so abigen does not also emit a
# colliding ___CFBundleGetFunctionPointerForName global.
_CFBundleGetFunctionPointerForName

# Apple Event Manager native-shadow bridge (ae_shim.c / ae_tramp.asm). Hand-
# written so the AE handler dispatch hands i386 a low-4GB shadow AEDesc and
# ___AEGetParamPtr resolves it to the ORIGINAL native descriptor (full 64-bit
# Handle) — the abigen bridge rebuilt a native AEDesc from the truncated i386
# fields and native AE dereferenced the chopped Handle (Civ 'oapp' crash inside
# AEGetParamDesc; the callback/down mirror of the a4ca917 pack fix). Excluded
# here so abigen does not also emit colliding ___AEGetParamPtr /
# ___AEInstallEventHandler globals.
_AEGetParamPtr
_AEInstallEventHandler

