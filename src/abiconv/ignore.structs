# Python C-API objects are OPAQUE HANDLES: the embedding app receives a PyObject*
# (etc.) from the interpreter and passes it back unchanged. Deep-copying them is
# both wrong (it breaks pointer identity — Python wouldn't recognise the copy) and
# explosive (PyObject -> PyTypeObject -> ... recursively unrolls to 80k+ asm lines
# per shim, blowing abiconv_legacy.asm to >100MB). Treat them as pass-through
# pointers (widen i386 4-byte -> x86_64 8-byte) instead. Matched on the as-written
# pointee spelling (typeconv convert_pointer), so list the typedef names the API
# uses in signatures plus the underlying struct tags used in field decls.
PyObject
const PyObject
struct _object
const struct _object
PyVarObject
PyTypeObject
const PyTypeObject
struct _typeobject
PyThreadState
struct _ts
PyInterpreterState
struct _is
PyFrameObject
struct _frame
PyCodeObject
PyCompilerFlags
PyTryBlock
PyMethodDef
PyModuleDef
PyGetSetDef
PyMemberDef

# libxml2 opaque handles (added with /usr/lib/libxml2.2.dylib in
# ABICONV_SYM_SOURCES; see includes.h <libxml/*>). IDENTICAL to the Python
# C-API case above: an i386 app receives xmlDocPtr/xmlNodePtr/&c from native
# libxml2 and passes them straight back to libxml2 functions. libxml2's
# structs are FULLY DEFINED in tree.h (not opaque like CF/sqlite3), so without
# this abigen tries to deep-marshal the pointee BY VALUE — which is both wrong
# (breaks pointer identity; native libxml2 wouldn't recognise the copy, and
# the i386/x86_64 layouts differ by pointer width) and explosive (xmlNode ->
# xmlDoc -> xmlDtd -> ... recursively unrolls to 12k-110k asm lines/shim; 794
# libxml2 shims were skipped as 'too large' before this). Treat them as
# pass-through pointers (widen i386 4-byte -> x86_64 8-byte). Matched on the
# as-written pointee spelling (typeconv convert_pointer), so list the typedef
# name + the struct tag, each plus a const variant.
htmlElemDesc
const htmlElemDesc
struct _htmlElemDesc
const struct _htmlElemDesc
htmlEntityDesc
const htmlEntityDesc
struct _htmlEntityDesc
const struct _htmlEntityDesc
